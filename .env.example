# ---------------------------------------------------------------
# Database credentials for docker compose.
#
# Copy this file to `.env` in the project ROOT (next to
# docker-compose.yml) and edit the values to whatever you want:
#
#     cp .env.example .env
#
# Both the `database` service and the `backend` service read these
# same three variables, so they can never drift apart.
#
# If you do not create a .env file at all, the defaults shown below
# are used and everything still works.
#
# ---------------------------------------------------------------
# IMPORTANT - read before changing these
# ---------------------------------------------------------------
# PostgreSQL only applies POSTGRES_USER / POSTGRES_PASSWORD /
# POSTGRES_DB the very FIRST time it starts with an empty data
# directory. Once the `postgres_data` volume exists, changing these
# values has NO effect - the old credentials keep working and the new
# ones appear to be ignored.
#
# To apply new values you must delete the volume first:
#
#     docker compose down -v
#     docker compose up --build
#
# `down -v` erases all stored orders. That is fine early on, but do
# not run it once you have data you care about.
# ---------------------------------------------------------------

POSTGRES_USER=postgres
# REQUIRED. docker-compose.yml deliberately has no fallback for this, so
# that no working password is ever committed to the repository. Compose
# refuses to start if it is missing.
POSTGRES_PASSWORD=change_me
POSTGRES_DB=coffee_machine

# ---------------------------------------------------------------
# Application settings
# ---------------------------------------------------------------
# Password a "boss" must supply to get queue priority (section 4.1.2).
# REQUIRED - the backend refuses to start without it, so that no clone
# of this project ever ships with a publicly known boss password.
BOSS_PASSWORD=change_me

# Timezone that defines month boundaries for the monthly report.
# Without it, "August" is ambiguous for a TIMESTAMPTZ column.
REPORT_TIMEZONE=Asia/Jerusalem

# How long the queue consumer simulates brewing a coffee, in seconds.
PREPARATION_SECONDS=10

# How long Docker waits for the worker to finish the coffee in progress
# before killing it (a Compose duration, e.g. 30s or 1m). Must be longer
# than PREPARATION_SECONDS, or a shutdown mid-brew leaves that order
# stuck on 'preparing'.
WORKER_STOP_GRACE_PERIOD=30s
