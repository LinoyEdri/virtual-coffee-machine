# ---------------------------------------------------------------
# Database credentials for docker compose.
#
# Copy this file to `.env` in the project ROOT (next to
# docker-compose.yml) and edit the values to whatever you want:
#
#     cp .env.example .env
#
# Both the `database` service and the `backend` service read these
# same three variables, so they can never drift apart.
#
# If you do not create a .env file at all, the defaults shown below
# are used and everything still works.
#
# ---------------------------------------------------------------
# IMPORTANT - read before changing these
# ---------------------------------------------------------------
# PostgreSQL only applies POSTGRES_USER / POSTGRES_PASSWORD /
# POSTGRES_DB the very FIRST time it starts with an empty data
# directory. Once the `postgres_data` volume exists, changing these
# values has NO effect - the old credentials keep working and the new
# ones appear to be ignored.
#
# To apply new values you must delete the volume first:
#
#     docker compose down -v
#     docker compose up --build
#
# `down -v` erases all stored orders. That is fine early on, but do
# not run it once you have data you care about.
# ---------------------------------------------------------------

POSTGRES_USER=postgres
POSTGRES_PASSWORD=coffee_password
POSTGRES_DB=coffee_machine
