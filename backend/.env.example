# ---------------------------------------------------------------
# Backend environment variables
# Copy this file to `.env` and adjust as needed:
#   cp backend/.env.example backend/.env
#
# NOTE: docker-compose.yml already supplies sane defaults for every
# variable below, so `docker compose up` works without a .env file.
# A local .env is only needed to override those defaults.
# ---------------------------------------------------------------

# Port the Express server listens on (inside the container)
PORT=3000

# Node environment: development | production
NODE_ENV=development

# The URL the API is reachable at from your browser. Used for log output
# only. Under Docker this differs from PORT above, because the container
# port (3000) is published on a different host port (3333).
PUBLIC_URL=http://localhost:3000

# --- Database -------------------------------------------------------
# Under Docker, DB_HOST is the compose service name (`database`).
# Running the backend directly on your machine, it is `localhost`.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=coffee_machine
DB_USER=postgres
# Required - the app refuses to start without it, on purpose.
DB_PASSWORD=coffee_password

# --- Application ----------------------------------------------------
# Password a "boss" must supply to get queue priority. Also required.
BOSS_PASSWORD=change_me
# Timezone defining month boundaries for the monthly report.
REPORT_TIMEZONE=Asia/Jerusalem
